# Copia in .env e riempi le chiavi. .env non va mai committato.

# LiveKit Cloud: url wss://<progetto>.livekit.cloud e le chiavi del progetto.
# Si ottengono con: lk cloud auth, poi lk app env -w (scrive LIVEKIT_* in .env.local)
# In locale invece: livekit-server --dev, LIVEKIT_URL=ws://localhost:7880, devkey / secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=

# Voce ElevenLabs: scegline una con cerca_voce.py (cerca, prova, aggiungi o progetta).
# Candidati italiani dalla Voice Library: Vittorio nH7uLS5UdEnvKEOAXtlQ, Max tULHfJ4iE8Pmlm5lOtto
# Vuoto = voce di default del plugin
ELEVEN_VOICE_ID=
# Ripiego se v4 Turbo dà problemi: eleven_flash_v2_5
ELEVEN_MODEL=eleven_v4_turbo

# Modello: Haiku 4.5 di default (il più rapido a rispondere); in alternativa claude-sonnet-5-5
BORDO_MODELLO=
# Effort per Sonnet e Opus (Haiku lo ignora). I turni sono a push to talk
BORDO_EFFORT=low
